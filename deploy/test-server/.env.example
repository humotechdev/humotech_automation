# Настройки тестового сервера HUMOTECH.
#
#   cp .env.example .env && chmod 600 .env
#
# Все переменные без значения здесь ОБЯЗАТЕЛЬНЫ: `docker compose` с
# пустой переменной останавливается с её именем, а не подставляет
# пароль по умолчанию. Файл .env в Git не попадает.
#
# Сгенерировать секрет:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# token_urlsafe даёт только [A-Za-z0-9_-] — это важно для POSTGRES_PASSWORD,
# он подставляется в строку подключения без экранирования.

# --- домены (без схемы) ---
# Mini App сотрудника и API. Сюда же ведёт кнопка бота.
API_DOMAIN=
# HR CRM. Её /api/* Caddy отправляет на тот же шлюз.
CRM_DOMAIN=
# Почта для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=

# --- база ---
POSTGRES_PASSWORD=

# --- Django ---
DJANGO_SECRET_KEY=

# --- Telegram ---
# Токен от @BotFather. Им подписывается initData Mini App: у кого токен,
# тот входит за любого сотрудника. Только здесь, никогда во frontend.
TELEGRAM_BOT_TOKEN=
# Имя бота без «@».
TELEGRAM_BOT_USERNAME=
# Общий секрет бота и backend (заголовок X-Bot-Token). Не короче 32
# символов — иначе backend не стартует (ImproperlyConfigured).
TELEGRAM_BOT_API_SECRET=

# --- QR-коды офиса ---
QR_SIGNING_SECRET=

# --- CRM (попадает в бандл и видно в браузере — не секрет) ---
# Код организации, в которую входят сотрудники CRM.
CRM_ORGANIZATION_CODE=
# Ключ Google Maps (ограничивать по HTTP referrer в консоли Google).
# Пусто — карта офиса на OpenStreetMap.
CRM_GOOGLE_MAPS_KEY=

# --- версия образов ---
# Обязателен. Тег, под которым собраны и запускаются образы humotech/*.
# Меняется ТОЛЬКО здесь (не export в оболочке): деплой — новый тег,
# откат — прежний. Пример: короткий хеш коммита.
HUMOTECH_TAG=

# --- необязательное ---
# С каких адресов открыт Django Admin (https://API_DOMAIN/admin/), через
# запятую. Пусто — /admin/ закрыт для всех (403).
GATEWAY_ADMIN_ALLOW=
# Подсеть edge, адрес Caddy в ней и диапазон динамических адресов.
# Менять, только если подсеть занята; адрес Caddy — вне диапазона.
# Шлюз верит X-Forwarded-For ровно адресу Caddy.
EDGE_SUBNET=
EDGE_CADDY_IP=
EDGE_DYNAMIC_RANGE=
# Потолок длины ответа AI-ассистента в токенах (по умолчанию 800).
# Ассистент на стенде выключен (AI_ASSISTANT_ENABLED=false).
AI_MAX_OUTPUT_TOKENS=
