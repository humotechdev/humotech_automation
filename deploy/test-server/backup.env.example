# Резервное копирование ТЕСТОВОГО СЕРВЕРА (deploy/test-server).
#
# Установка — deploy/test-server/README.md, раздел «Резервные копии»:
#   sudo install -m 600 deploy/test-server/backup.env.example /etc/humotech/backup.env
# и заполнить раздел «Шифрование». Значения секретов в репозиторий не
# коммитятся; в этом файле их нет.

# --- Источник: проект Docker Compose тестового сервера -------------------------
# `name: humotech_test` в deploy/test-server/docker-compose.yml. Контейнер базы
# и тома скрипт находит по меткам, которые ставит сам Compose
# (com.docker.compose.project / .service / .volume), а не по имени. Для
# справки, так их называет Compose v2 (проверено 25.09.2026 на поднятом стеке):
#   контейнер базы  humotech_test-postgres-1
#   тома            humotech_test_private_media, humotech_test_private_exports
# Проверить на сервере:
#   docker ps --filter label=com.docker.compose.project=humotech_test --filter label=com.docker.compose.service=postgres
#   docker volume ls --filter label=com.docker.compose.project=humotech_test
BACKUP_COMPOSE_PROJECT=humotech_test
BACKUP_PG_SERVICE=postgres
BACKUP_PG_USER=humotech
# Рабочая база создаётся deploy/test-server/initdb/01_databases.sql.
BACKUP_PG_DB=humotech_django
# Ключи томов из раздела volumes: compose-файла. Оба обязательны: если тома
# нет, копия не создаётся и скрипт завершается с ошибкой.
BACKUP_COMPOSE_VOLUMES="private_media private_exports"
# Выгрузки живут 72 часа и удаляются — пустой том выгрузок нормален.
BACKUP_ALLOW_EMPTY_VOLUMES="private_exports"
# Том с документами: в нём файлов не меньше, чем живых строк в таблице files.
# Пустым он может быть, только пока в базе нет ни одного живого файла.
BACKUP_MEDIA_VOLUME=private_media

# --- Хранение на сервере -----------------------------------------------------
BACKUP_DIR=/var/backups/humotech-test
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=6

# --- Шифрование ---------------------------------------------------------------
# На сервере — только ОТКРЫТЫЙ ключ age (строка age1...). Закрытый ключ — у
# владельца, см. docs/security/backups.md.
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_RECIPIENTS_FILE=
# Закрытый ключ нужен только restore-test.sh — на машине, где проверяют
# восстановление, а не на этом сервере.
BACKUP_AGE_IDENTITY_FILE=
BACKUP_GPG_RECIPIENT=

# --- Копия вне сервера (rclone, S3-совместимое хранилище) --------------------
BACKUP_REMOTE_ENABLED=false
BACKUP_RCLONE_REMOTE=offsite:humotech-backups/test-server
BACKUP_REMOTE_KEEP=90d
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# --- Проверка восстановления ----------------------------------------------------
BACKUP_RESTORE_IMAGE=pgvector/pgvector:pg18
BACKUP_HELPER_IMAGE=pgvector/pgvector:pg18
# Образ backend того же тега, что HUMOTECH_TAG в deploy/test-server/.env:
# `manage.py migrate --check` против восстановленной базы.
BACKUP_VERIFY_APP_IMAGE=humotech/backend:ЗАМЕНИТЬ_НА_HUMOTECH_TAG
BACKUP_VERIFY_SETTINGS=config.settings.test
