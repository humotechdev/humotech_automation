# Настройки стенда. Скопируйте в .env рядом с этим файлом.
#
#   copy .env.example .env
#
# .env отсюда читает только docker compose: он подставляет эти значения
# в docker-compose.local.yml. Настройки самих приложений лежат в их
# собственных .env (apps/backend-api/.env, apps/employee-telegram-bot/.env)
# и переопределяются в compose там, где внутри сети адреса другие.
#
# Файл .env в Git не попадает — шаблон `.env` в .gitignore закрывает его
# на любой глубине.

# Постоянный публичный адрес. Тот же поддомен должен быть заведён в
# Cloudflare как Public Hostname туннеля.
PUBLIC_HOSTNAME=hr-dev.humotech.com

# Токен именованного туннеля Cloudflare.
#
# Где взять: one.dash.cloudflare.com -> Networks -> Tunnels ->
# Create a tunnel -> Cloudflared -> Save. В показанной команде установки
# есть «--token eyJ...»; сюда вставляется эта строка без «--token».
#
# Затем вкладка Public Hostname -> Add:
#   Subdomain: hr-dev
#   Domain:    humotech.com
#   Type:      HTTP
#   URL:       gateway:80
#
# CNAME Cloudflare создаёт сам, поэтому адрес переживает любые
# перезапуски: ни tunnel ID, ни имя, ни DNS-запись не пересоздаются.
CLOUDFLARE_TUNNEL_TOKEN=
