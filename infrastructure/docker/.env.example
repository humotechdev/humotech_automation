# Настройки стенда. Скопируйте в .env рядом с этим файлом.
#
#   copy .env.example .env
#
# .env отсюда читает только docker compose: он подставляет эти значения
# в docker-compose.local.yml. Настройки самих приложений лежат в их
# собственных .env (apps/backend-api/.env, apps/employee-telegram-bot/.env)
# и переопределяются в compose там, где внутри сети Docker адреса другие.
#
# Файл .env в Git не попадает — шаблон `.env` в .gitignore закрывает его
# на любой глубине.

# Токен агента ngrok.
#
# Где взять: dashboard.ngrok.com -> Your Authtoken -> Copy.
#
# В чат его присылать не нужно и нельзя: этим токеном публикуется что
# угодно от имени вашего аккаунта. Он читается только контейнером ngrok
# через переменную окружения и в командную строку не попадает — иначе
# был бы виден в `docker ps` и в списке процессов.
NGROK_AUTHTOKEN=

# Постоянный домен, закреплённый за аккаунтом (Dev Domain).
#
# Где посмотреть: dashboard.ngrok.com -> Domains. На бесплатном тарифе
# он один и выдаётся сразу; менять его нельзя, а переставать он не
# перестаёт — переживает перезапуск агента, контейнеров и Windows.
#
# Без него агент выдал бы случайный адрес, и всё вернулось бы к тому,
# с чего начали: адрес меняется, кнопка бота устаревает.
#
# Пишется без схемы: `something.ngrok-free.dev`, не `https://...`.
NGROK_DOMAIN=
