# Настройки резервного копирования HUMOTECH.
#
# Скопируйте в /etc/humotech/backup.env (владелец root, права 600) и
# укажите путь в BACKUP_CONFIG. Класть backup.env рядом со скриптом внутри
# репозитория не стоит: .gitignore его сейчас не исключает.
# Значения секретов в репозиторий не коммитятся никогда.

# --- Источник ---------------------------------------------------------------
BACKUP_PG_CONTAINER=humotech_postgres
BACKUP_PG_USER=humotech
BACKUP_PG_DB=humotech_django
# Тома с загруженными документами и готовыми выгрузками. Имя тома =
# <имя проекта compose>_<том>; проверить: docker volume ls
BACKUP_VOLUMES="docker_private_media docker_private_exports"

# --- Хранение на сервере -----------------------------------------------------
BACKUP_DIR=/var/backups/humotech
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=6

# --- Шифрование ---------------------------------------------------------------
# age (рекомендуется) | gpg | none. На сервере — только ОТКРЫТЫЙ ключ.
BACKUP_ENCRYPTION=age
# Открытый ключ age (строка age1...) или файл с несколькими получателями.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_RECIPIENTS_FILE=
# Закрытый ключ нужен ТОЛЬКО restore-test.sh. На боевом сервере его нет:
# проверку восстановления запускают на отдельной машине, куда копию
# забирают из внешнего хранилища. См. docs/security/backups.md.
BACKUP_AGE_IDENTITY_FILE=
# Для gpg: отпечаток или e-mail открытого ключа из keyring root.
BACKUP_GPG_RECIPIENT=

# --- Копия вне сервера (rclone, S3-совместимое хранилище) --------------------
# По умолчанию выключено. Без шифрования включить нельзя — скрипт откажется.
BACKUP_REMOTE_ENABLED=false
# <имя remote>:<bucket>/<префикс>
BACKUP_RCLONE_REMOTE=offsite:humotech-backups/prod
# Сколько хранить во внешнем хранилище (формат rclone: 90d, 26w...).
# Лучше дополнительно включить в бакете Object Lock / версионирование и
# выдать ключу право только на запись: тогда взломанный сервер не сотрёт
# старые копии.
BACKUP_REMOTE_KEEP=90d
# Настройки remote «offsite» — переменными окружения rclone, без rclone.conf:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.net
# RCLONE_CONFIG_OFFSITE_REGION=
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# --- Проверка восстановления ----------------------------------------------------
BACKUP_RESTORE_IMAGE=pgvector/pgvector:pg18
BACKUP_HELPER_IMAGE=pgvector/pgvector:pg18
# Образ backend для `manage.py migrate --check` против восстановленной базы.
# Пусто — шаг пропускается.
BACKUP_VERIFY_APP_IMAGE=humotech/backend:local
BACKUP_VERIFY_SETTINGS=config.settings.test
