# Что не должно попадать в сборку Mini App.
#
# node_modules исключён намеренно: он собран под Windows, а ставится
# внутри образа под Linux. Скопировать хостовый — значит получить
# бинарные пакеты не той платформы и сборку, падающую без объяснений.
node_modules/
dist/

.env
.env.*
!.env.example

*.log
coverage/
.vite/
