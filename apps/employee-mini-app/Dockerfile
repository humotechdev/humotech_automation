# Mini App и обратный прокси в одном образе.
#
# Сервис называется `gateway`, и это имя записано в Cloudflare как адрес
# публичного hostname (`gateway:80`). Переименование сервиса потребует
# правки в панели Cloudflare, поэтому имя менять нельзя без причины.
#
# Почему приложение и прокси вместе: снаружи должен быть ОДИН origin —
# и статика Mini App, и `/api/` приходят с одного адреса. Тогда браузер
# не видит межсайтового запроса, CORS не участвует вовсе, а подпись
# Telegram и cookie ведут себя предсказуемо. Разделение на два сервиса
# дало бы второй origin и вернуло бы CORS без всякой пользы.

# --- сборка -----------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# npm ci, а не npm install: ставит ровно то, что записано в lock-файле.
# `install` вправе подтянуть более свежую совместимую версию, и тогда
# образ, собранный завтра, отличается от собранного сегодня.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Адрес API относительный (`/api/v1` — умолчание в src/api.ts), поэтому
# в bundle не попадает ни localhost, ни адрес туннеля, ни IP машины.
# Собранный файл одинаков для любого хоста, и смена домена его не трогает.
RUN npm run build

# --- раздача ----------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html

# Конфигурация лежит в infrastructure/docker/gateway/nginx.conf и
# монтируется томом: правка маршрутов не должна требовать пересборки
# фронтенда, это разные поводы для изменений.

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/gateway-health || exit 1
