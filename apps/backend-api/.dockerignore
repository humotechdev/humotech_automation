# Что не должно попадать в образ backend.
#
# Первая строка тут важнее прочих: .venv собран под Windows, внутри
# бинарники и .pyd, которые в Linux-образе не запустятся, а весит он
# сотни мегабайт. Копировать его — значит собирать медленно и получать
# образ, который ломается неочевидным образом.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Секреты. В образ не попадают никогда: настройки приходят окружением.
.env
.env.*
!.env.example

# Локальные данные разработчика.
private-media/
staticfiles/
media/
*.sqlite3
*.log

# Кэши инструментов.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Тесты в образе не нужны: он не для их запуска.
django_tests/

# Прежний слой Alembic — история, а не runtime.
migrations/
src/
