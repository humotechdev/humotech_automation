# Что не должно попадать в образ backend.
#
# Первая строка тут важнее прочих: .venv собран под Windows, внутри
# бинарники и .pyd, которые в Linux-образе не запустятся, а весит он
# сотни мегабайт. Копировать его — значит собирать медленно и получать
# образ, который ломается неочевидным образом.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Секреты. В образ не попадают никогда: настройки приходят окружением.
.env
.env.*
!.env.example

# Локальные данные разработчика. private-exports — готовые выгрузки с
# кадровыми данными: раньше они попадали в образ через `COPY . .` и
# оставались в его слое навсегда.
private-media/
private-exports/
staticfiles/
*.dump
*.sql.gz
*.pem
*.key
media/
*.sqlite3
*.log

# Кэши инструментов.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Тесты в образе не нужны: он не для их запуска. В tests/ к тому же
# лежали фикстуры с настоящим (скомпрометированным) токеном бота.
django_tests/
tests/
pytest.ini
pytest-legacy.ini
# requirements-dev.txt НЕ исключён: из этого же контекста собирается
# тестовый образ humotech/backend:test (см. README), и ему он нужен.

# Служебное, в работе не участвует.
.git/
.gitignore
.dockerignore
Dockerfile
README.md
*.md

# Прежний слой Alembic — история, а не runtime.
migrations/
src/
