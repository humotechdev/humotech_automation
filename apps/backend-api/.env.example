# Основная база
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:5432/humotech

# Отдельная база под тесты. ВНИМАНИЕ: тесты пересоздают в ней схему public,
# поэтому имя обязано содержать "test" — это проверяется в conftest.
TEST_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:5432/humotech_test

SQL_ECHO=false
LOG_LEVEL=INFO
