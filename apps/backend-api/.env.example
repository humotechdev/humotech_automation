# ============================================================
#  backend-api
#  Скопируйте в .env и заполните. .env в git не попадает.
# ============================================================

# --- база ---
# Django работает со своей базой. Контейнер из
# infrastructure/docker/docker-compose.yml слушает порт 5433, чтобы не
# конфликтовать с локально установленным PostgreSQL на 5432.
DJANGO_DATABASE_URL=postgresql://humotech:humotech_local@127.0.0.1:5433/humotech_django

# Ключ подписи Django. В production обязателен, значение по умолчанию
# там не подставляется. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Эталонная база для сверки схемы (test_schema_parity). Не задана —
# сверка с эталоном Alembic пропускается, остальные тесты идут как есть.
# Собрать её (одноразово, из корня backend-api):
#   docker exec humotech_postgres psql -U humotech -d postgres #     -c "CREATE DATABASE humotech_baseline OWNER humotech;"
#   DATABASE_URL=postgresql+psycopg://humotech:humotech_local@127.0.0.1:5433/humotech_baseline #     .venv/Scripts/python.exe -m pip install -r requirements-legacy.txt
#   DATABASE_URL=postgresql+psycopg://humotech:humotech_local@127.0.0.1:5433/humotech_baseline #     .venv/Scripts/python.exe -m alembic upgrade head
# ALEMBIC_BASELINE_URL=postgresql://humotech:humotech_local@127.0.0.1:5433/humotech_baseline

# --- прежний слой на SQLAlchemy ---
# Оставлен как независимая проверка поведения (pytest -c pytest-legacy.ini).
# Активным кодом не используется.
DATABASE_URL=postgresql+psycopg://humotech:humotech_local@127.0.0.1:5433/humotech
TEST_DATABASE_URL=postgresql+psycopg://humotech:humotech_local@127.0.0.1:5433/humotech_test

SQL_ECHO=false
LOG_LEVEL=INFO

# ============================================================
#  Telegram: привязка сотрудников и Mini App
# ============================================================

# Токен бота от @BotFather. Живёт ТОЛЬКО на сервере: им подписывается
# initData Mini App, и любой, у кого он есть, может выпустить строку от имени
# любого сотрудника. Во frontend не передаётся ни при каких условиях.
# Пустое значение = вход в Mini App закрыт (проверить подпись нечем).
TELEGRAM_BOT_TOKEN=

# Имя бота без «@». Из него собирается ссылка привязки
# https://t.me/<имя>?start=link_<ТОКЕН>. Без него выдать ссылку нельзя.
TELEGRAM_BOT_USERNAME=humotech_hr_bot

# Публичный адрес Mini App. Нужен, чтобы дать ссылку в интерфейсе и
# в настройках бота у @BotFather.
TELEGRAM_MINI_APP_URL=https://mini.humotech.tj

# Общий секрет между ботом и backend. Бот сообщает backend Telegram ID
# как факт — подтвердить его своими силами backend не может, поэтому
# запрос привязки принимается только с этим заголовком.
# Обязан совпадать с BACKEND_BOT_SECRET в apps/employee-telegram-bot/.env.
# Пустое значение = endpoint привязки закрыт для всех.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_API_SECRET=

# Сколько живёт строка initData. Рекомендация Telegram — 5 минут:
# она нужна только на обмен внутренний токен и дольше жить не должна.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# Сколько живёт ссылка привязки. Сутки: HR выдаёт её в рабочее время,
# человек открывает в тот же день или на следующее утро.
TELEGRAM_INVITATION_TTL_SECONDS=86400

# Срок внутреннего токена Mini App. Заметно больше initData: строка Telegram
# выдаётся один раз при запуске и не перевыпускается.
TELEGRAM_MINI_APP_SESSION_SECONDS=43200

# Origin'ы Mini App через запятую. Пусто = браузерных клиентов нет и CORS
# выключён. Умолчание закрытое: «разрешено всем» здесь недопустимо.
TELEGRAM_MINI_APP_ALLOWED_ORIGINS=

# Ограничение частоты обращений. Считается в кэше процесса.
THROTTLE_TELEGRAM_MINI_APP=30/min
THROTTLE_TELEGRAM_BOT_LINK=60/min
THROTTLE_TELEGRAM_INVITATIONS=60/min
# Личный кабинет сотрудника. Считается НА СОТРУДНИКА, а не на адрес:
# за одним офисным IP сидит весь офис, и общий счётчик закрыл бы доступ
# всем из-за одного.
THROTTLE_EMPLOYEE_SELF=120/min
# Отметки — строже: человек отмечается несколько раз в день, а не сто,
# и под общим пределом перебор кодов прошёл бы незамеченным.
THROTTLE_EMPLOYEE_SCAN=20/min
# Сопряжение экрана: перебор одноразового кода. Сопрягают экран один раз,
# руками, и повторять некому.
THROTTLE_QR_DISPLAY_PAIR=10/min
# Выдача кодов экрану. Экран обновляет код раз в полминуты; предел
# рассчитан на то, что после обрыва связи он попробует чаще.
THROTTLE_QR_DISPLAY_CODE=60/min


# --- QR-коды офиса ---
#
# Ключ подписи QR. ОТДЕЛЬНЫЙ от DJANGO_SECRET_KEY намеренно: сменить его
# можно в любой момент — протухнут коды на экранах, и через полминуты
# появятся новые; смена SECRET_KEY разлогинивает всю CRM. Во frontend
# не уходит ни один из них.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
QR_SIGNING_SECRET=

# Сколько живёт код на экране. Тридцать секунд — компромисс: короче
# неудобно человеку, который достаёт телефон; длиннее — больше окно,
# в котором сфотографированный код ещё действует.
QR_TOKEN_TTL_SECONDS=30

# Допустимое расхождение часов экрана и сервера. Без него код, выпущенный
# «в будущем» на секунду, отвергался бы весь свой срок.
QR_CLOCK_SKEW_SECONDS=10

# Сколько живёт credential экрана. Тридцать суток: экран висит на стене,
# и перевыпуск требует человека с доступом к нему.
QR_DISPLAY_CREDENTIAL_TTL_SECONDS=2592000

# Сколько живёт одноразовый код сопряжения. Час: его вводят сразу,
# а не хранят.
QR_DISPLAY_PAIRING_TTL_SECONDS=3600

# Origin'ы экранов показа QR. Список ОТДЕЛЬНЫЙ от списка Mini App:
# адрес приложения сотрудника не должен попутно открывать выдачу кодов.
# Пусто = зона закрыта.
QR_DISPLAY_ALLOWED_ORIGINS=


# --- Доверенные прокси ---
#
# Сколько прокси стоит перед приложением. Ноль означает: X-Forwarded-For
# не читается вовсе, адрес берётся из соединения.
#
# Умолчание закрытое намеренно. Заголовок подделывает кто угодно, и
# приложение, читающее его без настроенного прокси, само сообщает нужный
# адрес — а проверка «внутри офисной сети» держится ровно на нём.
TRUSTED_PROXY_COUNT=0


# --- Приложенные файлы ---
#
# Справка о болезни — медицинский документ. Каталог намеренно ВНЕ MEDIA_URL:
# веб-сервер из него ничего не раздаёт, файл отдаёт view, который сначала
# спрашивает, кому можно.
FILES_PROVIDER=local
# FILES_PRIVATE_ROOT=/var/lib/humotech/private-media

# Антивируса в проекте НЕТ. Пока флаг выключен, загруженный файл
# помечается CLEAN, и это означает «проверка не проводилась», а не
# «проверен и чист» (см. humotech/files/storage.py). Включение флага
# переводит новые файлы в PENDING, и до проверки они не отдаются.
FILES_SCANNER_ENABLED=false


# --- Очередь уведомлений ---
#
# Брокера нет: очередь живёт в PostgreSQL. Забирает её бот по HTTP —
# подключения к базе у него нет и заводить его ради двух запросов не нужно.
NOTIFICATIONS_POLL_INTERVAL_SECONDS=5
NOTIFICATIONS_BATCH_SIZE=20

# После стольких неудач сообщение помечается FAILED и больше не
# повторяется. Молча повторять вечно — способ не заметить, что доставка
# сломана.
NOTIFICATIONS_MAX_ATTEMPTS=5

# Пауза между попытками растёт по степеням двойки от базовой до предела.
NOTIFICATIONS_RETRY_BASE_SECONDS=30
NOTIFICATIONS_RETRY_MAX_SECONDS=3600

# Через сколько строка, зависшая в RUNNING, считается брошенной. Процесс
# отправщика мог упасть между захватом и результатом: блокировка строки
# снимется сама, статус — нет.
NOTIFICATIONS_LOCK_TIMEOUT_SECONDS=300

# ============================================================
#  AI-ассистент
#  По умолчанию ВЫКЛЮЧЕН. Не включать до утверждения HR-данных.
# ============================================================

# Ключ. Никогда не коммитить. Пустое значение = провайдер OpenAI недоступен.
OPENAI_API_KEY=

# Имена моделей задаются только здесь. В коде их нет.
# Неизвестное или недоступное имя даёт ConfigurationError,
# автоматического переключения на другую модель не происходит.
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Главный рубильник. false = ни одного обращения наружу.
AI_ASSISTANT_ENABLED=false
# Разрешён ли один резервный вызов fallback-модели на сложных вопросах.
AI_FALLBACK_ENABLED=true

# Пороги. Значения предварительные: окончательные выставим
# после прогона на реальных вопросах сотрудников.
AI_EXACT_FAQ_THRESHOLD=0.92
AI_RAG_MIN_SCORE=0.72
# Насколько близкими должны быть баллы двух РАЗНЫХ документов одного уровня,
# чтобы это считалось конфликтом и уходило к HR, а не решалось моделью.
AI_CONFLICT_SCORE_DELTA=0.05

AI_MAX_RETRIEVED_CHUNKS=6
AI_MAX_CONTEXT_TOKENS=4000
AI_QUERY_MAX_LENGTH=1000
AI_CACHE_TTL_SECONDS=900
AI_LOG_RETENTION_DAYS=90
AI_PROMPT_VERSION=v1

# Ограничение частоты запросов одного сотрудника
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200

# Кэш: memory | redis. Redis появится позже, интерфейс уже готов.
AI_CACHE_BACKEND=memory
# AI_REDIS_URL=redis://127.0.0.1:6379/0

# Языки, на которых ведётся база знаний
# Размерность вектора. Зашита в тип колонки vector(1536), поэтому менять
# её можно только вместе с миграцией — иначе поиск сломается молча.
AI_EMBEDDING_DIMENSIONS=1536

AI_SUPPORTED_LANGUAGES=ru
AI_DEFAULT_LANGUAGE=ru
