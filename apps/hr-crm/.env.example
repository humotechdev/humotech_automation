# Адрес API. По умолчанию — тот же origin, что и у самой CRM: так
# cookie сессии остаётся first-party, и CORS не нужен вовсе.
VITE_API_URL=/api/v1

# Код организации для входа. Backend опознаёт человека по тройке
# «организация + почта + пароль»: почта уникальна внутри организации,
# а не глобально. В форме этого поля нет намеренно — установка CRM
# принадлежит одной организации, и спрашивать её у человека незачем.
VITE_ORGANIZATION_CODE=DEMO

# Куда dev-сервер проксирует /api. Нужен только для `npm run dev`.
VITE_BACKEND_ORIGIN=http://gateway
