# Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram ---
# Токен бота от @BotFather. Тот же самый токен нужен backend-api под именем
# TELEGRAM_BOT_TOKEN: им подписывается initData Mini App, и проверить подпись
# без него нельзя. Во frontend не передаётся никогда.
BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Имя бота без «@». Боту нужно только для подсказок в текстах:
# сами ссылки привязки собирает backend, он же знает их срок.
BOT_USERNAME=humotech_hr_bot

# --- Личный кабинет ---
# Адрес Mini App: им открывается кнопка «Открыть личный кабинет». Пусто —
# кнопка не показывается вовсе: кнопка, которая ничего не открывает, хуже
# её отсутствия.
MINI_APP_URL=

# --- Backend API ---
BACKEND_API_URL=http://localhost:8000/api/v1
API_TIMEOUT_SECONDS=10

# Общий секрет с backend. Им бот доказывает, что telegram_user_id в запросе
# привязки пришёл от Telegram через него, а не выдуман отправителем запроса:
# проверить это своими силами backend не может.
# Значение обязано совпадать с TELEGRAM_BOT_API_SECRET в backend-api/.env.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_BOT_SECRET=

# --- Уведомления ---
# Как часто бот спрашивает очередь уведомлений у backend. Очередь живёт
# в PostgreSQL, но подключения к базе у бота нет: он ходит по HTTP.
NOTIFICATIONS_POLL_SECONDS=5

# --- Обратный канал backend -> bot ---
BOT_INTERNAL_TOKEN=change-me
BOT_INTERNAL_PORT=8081

# --- Прочее ---
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru
