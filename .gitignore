# --- Secrets ---
.env
.env.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
build/
.next/
*.tsbuildinfo

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Logs & temp ---
*.log
tmp/
image.png

# --- Django ---
staticfiles/
media/

# --- Приложенные файлы ---
# Справки и больничные листы. Каталог локального хранилища для разработки;
# в git ему делать нечего ни при каких условиях.
private-media/
# Готовые файлы выгрузок отчётов: кадровые данные, срок хранения которых
# считает сервер. Тем более не для git.
private-exports/

# Учётные данные для браузерной проверки. В репозитории им не место.
.secrets.*
.demo-backups/

# Настройки резервного копирования с паролями и ключами (образец —
# backup.env.example рядом). Шаблон `.env` выше такое имя не закрывает.
infrastructure/backup/backup.env
deploy/test-server/backup.env
*.env.local

# Дампы базы — все кадровые данные разом. В репозиторий не попадают
# ни при каком расположении.
*.dump
*.sql.gz
